{
  "name": "shiro",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter @shiro/web",
    "lint": "turbo lint",
    "prepare": "pnpm exec simple-git-hooks",
    "release": "bumpp -r",
    "release:dry": "bumpp -r --no-commit --no-tag --no-push"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx,json}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "bumpp": "^10.4.1",
    "lint-staged": "16.2.7",
    "simple-git-hooks": "2.13.1",
    "turbo": "^2.8.10"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
