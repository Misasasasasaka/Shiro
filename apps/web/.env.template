# Mix Space Core 14 V3 endpoint. Keep the /api/v3 suffix.
NEXT_PUBLIC_API_URL=https://core.example.com/api/v3
# Optional browser-facing endpoint when it differs from the server endpoint.
NEXT_PUBLIC_CLIENT_API_URL=
# Core origin; Shiro connects to /ws/web using native WebSocket.
NEXT_PUBLIC_GATEWAY_URL=https://core.example.com

# Must match the secret configured for the Core webhook target /api/webhook.
WEBHOOK_SECRET=
TMDB_API_KEY=
GH_TOKEN=
ASSETPREFIX=
